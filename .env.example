# Salin file ini menjadi .env lalu ganti nilainya. JANGAN commit file .env.
# Semua nilai di bawah hanya contoh/dummy.

# Port yang dibuka di komputer (http://localhost:3000)
APP_PORT=3000

# Port Adminer (hanya dipakai bila profile "tools" dinyalakan)
ADMINER_PORT=8080

# Pengaturan database
DB_NAME=kamus_daerah
DB_USER=kamus_user
DB_PASSWORD=ganti_password_user_db
MYSQL_ROOT_PASSWORD=ganti_password_root_db

# Token admin untuk menambah/mengubah/menghapus kata (isi string acak yang panjang)
ADMIN_TOKEN=ganti_token_admin_acak
